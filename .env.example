# ==============================================================================
# AgentCTL Configuration Environment Variables
# Copy this file to .env and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider & Local Inference
# ------------------------------------------------------------------------------
# Provider: 'local', 'openai', or 'auto' (default: attempts local first, falls back to OpenAI)
AGENTCTL_LLM_PROVIDER=auto
AGENTCTL_LOCAL_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
AGENTCTL_LOCAL_LLM_MODEL=qwen3.5-9b

# OpenAI LLM Configuration (fallback or primary when AGENTCTL_LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
AGENTCTL_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Conversational Identity & Style
# ------------------------------------------------------------------------------
AGENTCTL_AGENT_NAME=Bella
AGENTCTL_USER_NAME=Benin

# ------------------------------------------------------------------------------
# 3. Kokoro Neural TTS Settings
# ------------------------------------------------------------------------------
AGENTCTL_TTS_VOICE=af_bella
AGENTCTL_TTS_SPEED=1.0
# AGENTCTL_TTS_DEVICE=default
AGENTCTL_TTS_MODELS_DIR=~/.local/share/agentctl/models/kokoro
AGENTCTL_TAIL_DELAY_MS=250

# ------------------------------------------------------------------------------
# 4. Session & Conversation Loop
# ------------------------------------------------------------------------------
# Number of idle seconds before session auto-terminates (leave unset for no timeout)
# AGENTCTL_SESSION_IDLE_TIMEOUT_S=60

# ------------------------------------------------------------------------------
# 5. Speech-to-Text (Whisper) & VAD
# ------------------------------------------------------------------------------
AGENTCTL_AUDIO_CUTOFF=0.015
AGENTCTL_SILENCE_CUTOFF_MS=1750

# ------------------------------------------------------------------------------
# 6. Overlay UI & Edge Glow
# ------------------------------------------------------------------------------
AGENTCTL_FULLSCREEN=1
AGENTCTL_ORB_SIZE=120
AGENTCTL_EDGE_GLOW_ENABLED=1
AGENTCTL_EDGE_GLOW_BAND_PX=80
AGENTCTL_EDGE_GLOW_IDLE_INTENSITY=0.0
AGENTCTL_EDGE_GLOW_CORNER_RADIUS_PX=28
AGENTCTL_EDGE_GLOW_SCREENS=all

# ------------------------------------------------------------------------------
# 7. Privacy & Logging
# ------------------------------------------------------------------------------
RUST_LOG=info
# Set to 1 only for local debugging (logs user transcript and token strings)
AGENTCTL_LOG_TEXT=0

