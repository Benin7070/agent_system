[Unit]
Description=AgentCTL Voice UI
After=agentctl-daemon.service graphical-session.target
Requires=agentctl-daemon.service

[Service]
Type=simple
ExecStart=%h/Programming/agents/.venv/bin/python -m agentctl.hotkey
Restart=on-failure
RestartSec=3s
Environment=DISPLAY=:0
Environment=PYTHONPATH=%h/Programming/agents/src

[Install]
WantedBy=graphical-session.target

